# Launcher file for Dawn and Dusk. Copy it into
#   .../Documents/Paradox Interactive/Hearts of Iron IV/mod/
# (next to your clone) and set path to the mod/ folder INSIDE the clone,
# with forward slashes. The launcher loads only that folder.
# Same lines as mod/descriptor.mod; keep the two in step.

version="0.0.1"
tags={
	"Alternative History"
	"Gameplay"
	"Ideologies"
}
name="Dawn and Dusk"
supported_version="1.19.*"


replace_path="common/bookmarks"
replace_path="history/countries"

replace_path="common/national_focus"
replace_path="common/focus_inlay_windows"
replace_path="events"
replace_path="common/decisions"
replace_path="common/decisions/categories"
replace_path="common/bop"
replace_path="common/ai_strategy_plans"
replace_path="common/on_actions"

replace_path="history/units"

replace_path="common/ideologies"
path="C:/Users/YOUR_NAME/Documents/Paradox Interactive/Hearts of Iron IV/mod/Dawn_and_Dusk/mod"
